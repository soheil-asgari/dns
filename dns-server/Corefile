.:53 {
    bind 0.0.0.0
    health
    prometheus :9153
    
    # Log all queries
    log
    errors
    
    # Gaming-specific plugin (custom) — must come before forward per plugin.cfg
    # gaming_filter {
    #     redis_addr redis:6379
    #     refresh_interval 60s
    #     proxy_ip 10.10.0.1
    # }
    
    # Cache responses
    cache {
        success 512 30 60
        denial 128 5 30
    }
    
    # Forward to upstream DNS for non-gaming domains
    forward . 8.8.8.8 8.8.4.4 {
        max_concurrent 1000
    }
}

# Health check / debug endpoint
.:8053 {
    bind 0.0.0.0
    whoami
}