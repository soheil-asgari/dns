.:53 {
    health
    prometheus :9153
    errors

    gaming_filter {
        redis_addr redis:6379
        refresh_interval 5s
        proxy_ip 185.226.119.97
    }

    cache 3600 {
        success 3600
        denial 60
        prefetch 30 30s 25%
        serve_stale 1h
    }

    forward . 1.1.1.1 8.8.8.8 9.9.9.9 {
        policy sequential
        health_check 5s
        max_concurrent 4000
        expire 10s
    }
}

