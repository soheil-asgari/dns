.:53 {
    health
    prometheus :9153
    
    # Log all queries
    log
    errors
    
    # Gaming-specific plugin (custom) — must come before forward per plugin.cfg
    gaming_filter {
        redis_addr redis:6379
        refresh_interval 5s
        proxy_ip 37.32.28.44
    }
    
    # Cache responses — low TTL so new Redis entries are picked up within seconds
    cache 5 {
        success 5
        denial 5
    }
    
    # Forward to upstream DNS for non-gaming domains
    forward . 8.8.8.8 1.1.1.1 {
        max_concurrent 2000
        prefer_udp
    }
}

# Health check / debug endpoint
.:8053 {
    whoami
}